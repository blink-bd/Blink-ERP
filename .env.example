# Database
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=erp_password_2024
POSTGRES_DB=erp_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://erp_user:erp_password_2024@localhost:5432/erp_db

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=localhost
MINIO_BUCKET_NAME=erp-uploads

# API
API_PORT=3000
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET=your-very-long-and-secure-access-secret-key-change-this-in-production-12345678
JWT_REFRESH_SECRET=your-very-long-and-secure-refresh-secret-key-change-this-in-production-87654321
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Application
APP_NAME=ERP System
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Logging
LOG_LEVEL=debug

# Master Admin (المدير العام) — منفصل تماماً عن مستخدمي التجار
JWT_MASTER_SECRET=change-me-master-secret-at-least-32-chars-long-9d8f7a6b5c
MASTER_ADMIN_EMAIL=master@example.com
# ⚠️ أي قيمة فيها # لازم تتحط بين علامتي تنصيص، وإلا اللي بعد # هيتشال كأنه تعليق
MASTER_ADMIN_PASSWORD="ChangeMe!Master#2024"
MASTER_ADMIN_NAME=المدير العام

# ---------------------------------------------------------------------------
# الأمان (Security)
# ---------------------------------------------------------------------------
# كل أسرار JWT لازم 32+ حرف ومختلفة عن بعض — السيرفر يرفض يشتغل في الإنتاج غير كده.
# ولّد قيمة عشوائية:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# مفتاح تشفير أسرار المصادقة الثنائية للمدير العام (لو فاضي بيستخدم JWT_MASTER_SECRET).
# مهم: لو غيرته بعد تفعيل 2FA لازم تعمل MASTER_ADMIN_RESET_2FA=true مرة واحدة.
MASTER_2FA_ENCRYPTION_KEY=
# تقييد لوحة المدير العام على IPs معينة (مفصولة بفاصلة، يدعم CIDR زي 41.33.0.0/16). فاضي = أي IP.
MASTER_ADMIN_ALLOWED_IPS=
# طوارئ فقط: true مرة واحدة لإعادة تعيين كلمة مرور المدير العام من MASTER_ADMIN_PASSWORD ثم احذفه.
MASTER_ADMIN_RESET_PASSWORD=
# طوارئ فقط: true مرة واحدة لو فقدت تطبيق Authenticator ثم احذفه فوراً.
MASTER_ADMIN_RESET_2FA=
# عدد الـ Proxies قدام السيرفر (Render/Cloudflare = 1) عشان IP العميل الحقيقي يظهر صح
# في الـ Rate limit وسجل التدقيق وقائمة IPs المسموحة. لا تزوده عن العدد الحقيقي.
TRUST_PROXY_HOPS=1
# الحد الأقصى للطلبات في الدقيقة لكل IP (محلات فيها كذا كاشير على نفس الراوتر محتاجة رقم أعلى).
THROTTLE_LIMIT=300
# FRONTEND_URL يقبل أكثر من رابط مفصولين بفاصلة: https://app.example.com,https://www.example.com

# ---------------------------------------------------------------- Database (اختياري)
# تسجيل استعلامات SQL (بيطبع البيانات — فعّله مؤقتاً للتشخيص فقط)
DB_LOGGING=false
# SSL في الإنتاج: false = بدون SSL (شبكة خاصة) | ضع شهادة السيرفر في DB_SSL_CA للتحقق الكامل
# DB_SSL=false
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DB_SSL_REJECT_UNAUTHORIZED=true
