# Database
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=erp_password_2024
POSTGRES_DB=erp_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://erp_user:erp_password_2024@localhost:5432/erp_db

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=localhost
MINIO_BUCKET_NAME=erp-uploads

# API
API_PORT=3000
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET=your-very-long-and-secure-access-secret-key-change-this-in-production-12345678
JWT_REFRESH_SECRET=your-very-long-and-secure-refresh-secret-key-change-this-in-production-87654321
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Authentication cookies (production requires Secure; SameSite=None is required for cross-site API deployments)
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
# Optional: set only when frontend and API share a registrable domain, e.g. .example.com
AUTH_COOKIE_DOMAIN=

# Application
APP_NAME=ERP System
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=
PUBLIC_APP_URL=http://localhost:5173

# Email notifications (Gmail requires a Google App Password, not your account password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=blinkbusinessdevelopment@gmail.com
MAIL_PASSWORD=
MAIL_FROM=blinkbusinessdevelopment@gmail.com
NOTIFICATION_EMAIL_TO=blinkbusinessdevelopment@gmail.com

# WhatsApp Cloud API (Meta). Outside the 24-hour service window, configure an approved template.
WHATSAPP_API_VERSION=v26.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TO=+201024898091
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=ar

# Integrations and backup alerts (use generated secrets in production)
WEBHOOK_ENCRYPTION_KEY=replace-with-a-random-secret-of-at-least-32-characters
BACKUP_ALERT_TOKEN=replace-with-a-long-random-secret
REMINDERS_JOB_TOKEN=replace-with-a-long-random-secret

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Logging
LOG_LEVEL=debug

# Master Admin (المدير العام) — منفصل تماماً عن مستخدمي التجار
JWT_MASTER_SECRET=change-me-master-secret-at-least-32-chars-long-9d8f7a6b5c
MASTER_ADMIN_EMAIL=master@example.com
MASTER_ADMIN_PASSWORD=ChangeMe!Master#2024
MASTER_ADMIN_NAME=المدير العام
